{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ES2022",
    "noEmit": false,
    "rootDir": "./src",
    "outDir": "./dist",
    "incremental": false,
    "plugins": []
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "public",
    ".next",
    "app"
  ]
}
